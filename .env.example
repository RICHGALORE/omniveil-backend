ENVIRONMENT=development
DATABASE_URL=sqlite:///./omniveil.db

# Browser-facing origins, comma-separated in production.
ALLOWED_ORIGINS=http://localhost:3000

# Required production secrets. Never commit their real values.
OV_SIGNING_SECRET=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Ed25519 Trust Authority certificate signing. Required when ENVIRONMENT=production.
# Generate/store these outside Git (Render secrets, KMS, or a secrets manager).
OV_SIGNING_PRIVATE_KEY_B64=
OV_SIGNING_PUBLIC_KEY_B64=
OV_SIGNING_KEY_ID=

# Demo access is enabled by default only outside production.
SEED_DEMO_CLIENT=true
DEMO_TENANT_ID=demo-tenant
DEMO_API_KEY=replace-with-a-stable-development-key

# Optional external detection services.
# HIVE_API_KEY is retained only as a legacy visual-media fallback. Prefer the
# explicit project/model keys so evidence is never silently attributed to the
# wrong Hive model family.
HIVE_API_KEY=
HIVE_MEDIA_API_KEY=
HIVE_AUDIO_API_KEY=
HIVE_MUSIC_API_KEY=
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# Durable file storage. Render production mounts its persistent disk here.
UPLOAD_DIR=uploads

# Tenant-scoped limits for expensive file-processing endpoints.
OV_RATE_LIMIT_UPLOAD=20/minute
OV_RATE_LIMIT_SPECTRA_SCAN=30/minute
OV_RATE_LIMIT_DETECTOR_REFRESH=10/minute
OV_RATE_LIMIT_C2PA_READ=30/minute
# Optional shared SlowAPI storage backend for multi-instance deployments.
OV_RATE_LIMIT_STORAGE_URI=
